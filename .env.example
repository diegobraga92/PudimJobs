# ---------------------------------------------------------------------------
# PudimJobs — Docker Compose environment
# ---------------------------------------------------------------------------
# Copy to `.env` (git-ignored) and adjust for your machine:
#
#     cp .env.example .env
#
# Docker Compose reads `.env` from the project root automatically, so no extra
# flags are needed. The defaults baked into docker-compose.yml already match the
# values below and avoid the usual web ports (80, 3000, 4200, 5432, 6379, 8000,
# 9090, ...). Change any value here if a port is still occupied on your host
# (check with `ss -tlnp` or `docker ps`).
#
# Services that never talk to the outside world (PostgreSQL, Redis, RabbitMQ
# AMQP, Jaeger OTLP, Mailpit SMTP) are NOT exposed to the host at all — they
# live on Docker's internal network only. The FastAPI backend is exposed on an
# optional host port (PJ_BACKEND_PORT below) for native mobile clients and API
# tooling; browsers keep using the Angular proxy.
# ---------------------------------------------------------------------------

# Angular frontend — the main UI that LAN users open in a browser.
# The Angular dev server proxies /api to the backend inside the Docker network.
PJ_FRONTEND_PORT=9400

# FastAPI backend — exposed to the host so the React Native app can call /api
# directly (Android emulator reaches it via 10.0.2.2). Mobile apps are not
# subject to CORS. Not required for the web UI, which uses the Angular proxy.
PJ_BACKEND_PORT=8000

# Grafana — admin dashboards (RED metrics, scraper stats, data quality).
# Login: admin / admin (see docker-compose.yml).
PJ_GRAFANA_PORT=9300

# Prometheus — metrics endpoint + expression browser.
PJ_PROMETHEUS_PORT=9409

# Jaeger — distributed tracing UI.
PJ_JAEGER_UI_PORT=9668

# RabbitMQ management console (broker / queue inspection).
# Login: pudimjobs / pudimjobs_dev (see docker-compose.yml).
PJ_RABBITMQ_MGMT_PORT=9672

# Mailpit — dev email inbox UI.
PJ_MAILPIT_PORT=9025

# Comma-separated browser origins allowed to call the FastAPI backend directly
# (CORS). In the normal UI flow the browser only talks to the frontend origin
# (which proxies /api internally), so CORS is not triggered. Add an entry if you
# want to open the backend Swagger UI (/docs) or call the API directly from a
# browser on another machine, e.g.:
#   PJ_CORS_ORIGINS=http://localhost:9400,http://127.0.0.1:9400,http://192.168.1.50:9400
PJ_CORS_ORIGINS=http://localhost:9400,http://127.0.0.1:9400

# ---------------------------------------------------------------------------
# Optional LLM features — CV import structuring, ATS review, CV tailoring
# (ADR 006 / ADR 016)
# ---------------------------------------------------------------------------
# The admin panel (Admin → LLM) stores the runtime LLM config in the database
# (enable toggle, base URL, model, encrypted API key) and is the preferred way
# to set it up — enabling it there also turns on the second, full-LLM tailoring
# variant (ADR 016). The variables below only matter as the *environment
# fallback* used when no DB row has been saved yet.

# Fallback default for the admin panel's "Enable LLM features" toggle. When the
# LLM is enabled with a stored API key, a tailor run produces both the
# deterministic (`variant=rule`) and the LLM-rewritten (`variant=llm`) tailored
# CV. The deterministic variant is produced regardless, and a failing LLM call
# never fails the run.
TAILORING_LLM_ENABLED=false

# Any OpenAI-compatible endpoint works. Thinking-mode models (e.g. DeepSeek's
# `deepseek-flash` / `deepseek-reasoner`) must have their chain-of-thought turned
# off for these features: it shares `max_tokens` with the answer, so the reply
# comes back empty and the feature silently degrades. `app/services/llm_client.py`
# sends `thinking: {"type": "disabled"}` automatically when the base URL contains
# "deepseek"; it also asks for a bare JSON object and logs `llm_empty_content`
# when a 200 carries no usable content. Admin → LLM "Test connection" exercises
# the same request, so a green result there means the features will work too.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

