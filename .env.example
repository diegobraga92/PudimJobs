# ---------------------------------------------------------------------------
# PudimJobs — Docker Compose environment
# ---------------------------------------------------------------------------
# Copy to `.env` (git-ignored) and adjust for your machine:
#
#     cp .env.example .env
#
# Docker Compose reads `.env` from the project root automatically, so no extra
# flags are needed. The defaults baked into docker-compose.yml already match the
# values below and avoid the usual web ports (80, 3000, 4200, 5432, 6379, 8000,
# 9090, ...). Change any value here if a port is still occupied on your host
# (check with `ss -tlnp` or `docker ps`).
#
# Services that never talk to the outside world (PostgreSQL, Redis, RabbitMQ
# AMQP, FastAPI backend, Jaeger OTLP, Mailpit SMTP) are NOT exposed to the host
# at all — they live on Docker's internal network only.
# ---------------------------------------------------------------------------

# Angular frontend — the main UI that LAN users open in a browser.
# The Angular dev server proxies /api to the backend inside the Docker network.
PJ_FRONTEND_PORT=9400

# Grafana — admin dashboards (RED metrics, scraper stats, data quality).
# Login: admin / admin (see docker-compose.yml).
PJ_GRAFANA_PORT=9300

# Prometheus — metrics endpoint + expression browser.
PJ_PROMETHEUS_PORT=9409

# Jaeger — distributed tracing UI.
PJ_JAEGER_UI_PORT=9668

# RabbitMQ management console (broker / queue inspection).
# Login: pudimjobs / pudimjobs_dev (see docker-compose.yml).
PJ_RABBITMQ_MGMT_PORT=9672

# Mailpit — dev email inbox UI.
PJ_MAILPIT_PORT=9025

# Comma-separated browser origins allowed to call the FastAPI backend directly
# (CORS). In the normal UI flow the browser only talks to the frontend origin
# (which proxies /api internally), so CORS is not triggered. Add an entry if you
# want to open the backend Swagger UI (/docs) or call the API directly from a
# browser on another machine, e.g.:
#   PJ_CORS_ORIGINS=http://localhost:9400,http://127.0.0.1:9400,http://192.168.1.50:9400
PJ_CORS_ORIGINS=http://localhost:9400,http://127.0.0.1:9400
