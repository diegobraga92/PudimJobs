# PudimJobs mobile — API configuration
#
# Override the API base URL the app talks to. When unset:
#   - Android emulator -> http://10.0.2.2:8000/api (host loopback)
#   - iOS simulator   -> http://localhost:8000/api
# Physical devices need the LAN IP of the machine running the backend, e.g.:
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
