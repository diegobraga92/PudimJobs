<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"></head>
<body style="margin:0;background:#f4f6f8;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6f8;padding:24px;">
    <tr><td align="center">
      <table role="presentation" width="540" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:10px;overflow:hidden;">
        <tr><td style="background:#1e3a5f;padding:18px 28px;">
          <span style="color:#ffffff;font-size:20px;font-weight:700;">PudimJobs</span>
        </td></tr>
        <tr><td style="padding:28px;">
          <h1 style="margin:0 0 8px;font-size:18px;color:#16324f;">New job match 🎯</h1>
          <p style="margin:0 0 16px;color:#555;font-size:14px;">
            <strong>{{ job_title }}</strong> at <strong>{{ job_company }}</strong>
            matches your alert "<strong>{{ rule_name }}</strong>".
          </p>
          {% if job_url %}
            <p style="margin:0 0 20px;">
              <a href="{{ job_url }}" style="background:#1e3a5f;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:6px;font-size:14px;">
                View the job
              </a>
            </p>
          {% endif %}
          <p style="margin:0;color:#999;font-size:12px;">You are receiving this because of an alert rule in PudimJobs.</p>
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
