<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
  @page { size: A4; margin: 1.6cm 1.8cm; }
  /* One shared leading/margin scale so Summary, Experience and every other
     section read with the same rhythm. Previously the summary <p> kept the
     UA's 1em margins and a 1.5 line-height while bullets ran tighter, so the
     two sections looked like different documents. */
  /* The UA gives <body> an 8px margin, which silently narrowed the content box
     to 16.98cm instead of the 17.4cm that A4 minus the @page inset promises.
     Reset it so the @page margin is the only inset (the ATS template does the
     same, and ADR 021's measurements assume this width). */
  body { margin: 0; font-family: 'DejaVu Sans', sans-serif; font-size: 10pt;
         color: #222; line-height: 1.4; }
  p { margin: 0 0 6px; }
  h1 { font-size: 20pt; margin: 0 0 4px; color: #16324f; }
  /* One flowing line: email, phone, location and links share a single block
     instead of a details line plus a links line (ADR 021). Fields stay
     unbreakable, but the separator between two fields does offer a break, so the
     block packs greedily onto one line and spills over between fields only:
     never mid-token, never past the page edge. 8pt is the size at which a real
     five-field line (109 characters) fits in the 17.4cm A4 text block: measured
     472.9pt of the 493.2pt available, where 9.5pt wrapped onto a second line. */
  .contact { color: #555; font-size: 8pt; margin-bottom: 14px; }
  .contact .ci { white-space: nowrap; }
  .contact .sep { color: #b9c4cf; }
  h2 { font-size: 11pt; text-transform: uppercase; letter-spacing: 1px;
       border-bottom: 1px solid #b9c4cf; padding-bottom: 2px; margin: 14px 0 6px;
       color: #16324f; }
  .experience-item { margin-bottom: 8px; }
  .experience-header { font-weight: bold; }
  .experience-header .date { font-weight: normal; color: #555; float: right; font-size: 9pt; }
  ul { margin: 2px 0 6px; padding-left: 18px; }
  li { margin-bottom: 2px; }
  .skills { line-height: 1.4; }
  .skill-group { margin-bottom: 2px; }
  .education-item { margin-bottom: 4px; }
  .project-desc { margin: 2px 0 4px; }
  .project-link { font-size: 9pt; color: #555; margin-bottom: 4px; }
  .cert-item, .lang-item { margin-bottom: 2px; }
</style>
</head>
<body>
  {% if name %}<h1>{{ name }}</h1>{% endif %}
  {% set contact_bits = [] %}
  {% if email %}{% set _ = contact_bits.append(email) %}{% endif %}
  {% if phone %}{% set _ = contact_bits.append(phone) %}{% endif %}
  {% if location %}{% set _ = contact_bits.append(location) %}{% endif %}
  {% if links %}{% set _ = contact_bits.extend(links) %}{% endif %}
  {% if contact_bits %}
    <div class="contact">{% for bit in contact_bits %}<span class="ci">{{ bit }}</span>{% if not loop.last %}<span class="sep"> • </span>{% endif %}{% endfor %}</div>
  {% endif %}

  {% if summary %}
    <h2>Summary</h2>
    <p>{{ summary }}</p>
  {% endif %}

  {% if experience %}
    <h2>Experience</h2>
    {% for exp in experience %}
      <div class="experience-item">
        <div class="experience-header">
          {{ exp.title }} — {{ exp.company }}
          {% if exp.start_date or exp.end_date %}
            <span class="date">{{ exp.start_date or '' }} – {{ exp.end_date or 'Present' }}</span>
          {% endif %}
        </div>
        {% if exp.bullets %}
          <ul>
            {% for bullet in exp.bullets %}<li>{{ bullet }}</li>{% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endfor %}
  {% endif %}

  {% if skill_groups %}
    <h2>Skills</h2>
    <div class="skills">
      {% for label, items in skill_groups %}
        <div class="skill-group"><strong>{{ label }}:</strong> {{ items | join(', ') }}</div>
      {% endfor %}
    </div>
  {% endif %}

  {% if projects %}
    <h2>Projects</h2>
    {% for proj in projects %}
      <div class="experience-item">
        <div class="experience-header">{{ proj.name }}</div>
        {% if proj.description %}<div class="project-desc">{{ proj.description }}</div>{% endif %}
        {% if proj.link %}<div class="project-link">{{ proj.link }}</div>{% endif %}
      </div>
    {% endfor %}
  {% endif %}

  {% if education %}
    <h2>Education</h2>
    {% for edu in education %}
      <div class="education-item">
        {{ edu.degree }}, {{ edu.institution }}{% if edu.year %} ({{ edu.year }}){% endif %}
      </div>
    {% endfor %}
  {% endif %}

  {% if certifications %}
    <h2>Certifications</h2>
    {% for cert in certifications %}
      <div class="cert-item">{{ cert }}</div>
    {% endfor %}
  {% endif %}

  {% if languages %}
    <h2>Languages</h2>
    {% for lang in languages %}
      <div class="lang-item">{{ lang }}</div>
    {% endfor %}
  {% endif %}
</body>
</html>
