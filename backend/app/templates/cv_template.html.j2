<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
  @page { size: A4; margin: 1.6cm 1.8cm; }
  body { font-family: 'DejaVu Sans', sans-serif; font-size: 10pt; color: #222; }
  h1 { font-size: 20pt; margin: 0 0 2px; color: #16324f; }
  .contact { color: #555; margin-bottom: 14px; font-size: 9.5pt; }
  h2 { font-size: 11pt; text-transform: uppercase; letter-spacing: 1px;
       border-bottom: 1px solid #b9c4cf; padding-bottom: 2px; margin: 14px 0 6px;
       color: #16324f; }
  .experience-item { margin-bottom: 8px; }
  .experience-header { font-weight: bold; }
  .experience-header .date { font-weight: normal; color: #555; float: right; font-size: 9pt; }
  ul { margin: 2px 0 6px; padding-left: 18px; }
  li { margin-bottom: 2px; }
  .skills { line-height: 1.7; }
  .summary { line-height: 1.5; }
  .education-item { margin-bottom: 4px; }
  .project-desc { margin: 2px 0 4px; line-height: 1.5; }
  .project-link { font-size: 9pt; color: #555; margin-bottom: 4px; }
  .cert-item, .lang-item { margin-bottom: 2px; }
</style>
</head>
<body>
  {% if name %}<h1>{{ name }}</h1>{% endif %}
  {% set contact_bits = [] %}
  {% if email %}{% set _ = contact_bits.append(email) %}{% endif %}
  {% if phone %}{% set _ = contact_bits.append(phone) %}{% endif %}
  {% if location %}{% set _ = contact_bits.append(location) %}{% endif %}
  {% if links %}{% set _ = contact_bits.extend(links) %}{% endif %}
  {% if contact_bits %}<div class="contact">{{ contact_bits | join(' • ') }}</div>{% endif %}

  {% if summary %}
    <h2>Summary</h2>
    <p class="summary">{{ summary }}</p>
  {% endif %}

  {% if experience %}
    <h2>Experience</h2>
    {% for exp in experience %}
      <div class="experience-item">
        <div class="experience-header">
          {{ exp.title }} — {{ exp.company }}
          {% if exp.start_date or exp.end_date %}
            <span class="date">{{ exp.start_date or '' }} – {{ exp.end_date or 'Present' }}</span>
          {% endif %}
        </div>
        {% if exp.bullets %}
          <ul>
            {% for bullet in exp.bullets %}<li>{{ bullet }}</li>{% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endfor %}
  {% endif %}

  {% if skills %}
    <h2>Skills</h2>
    <div class="skills">{{ skills | join(', ') }}</div>
  {% endif %}

  {% if projects %}
    <h2>Projects</h2>
    {% for proj in projects %}
      <div class="experience-item">
        <div class="experience-header">{{ proj.name }}</div>
        {% if proj.description %}<div class="project-desc">{{ proj.description }}</div>{% endif %}
        {% if proj.link %}<div class="project-link">{{ proj.link }}</div>{% endif %}
      </div>
    {% endfor %}
  {% endif %}

  {% if education %}
    <h2>Education</h2>
    {% for edu in education %}
      <div class="education-item">
        {{ edu.degree }}, {{ edu.institution }}{% if edu.year %} ({{ edu.year }}){% endif %}
      </div>
    {% endfor %}
  {% endif %}

  {% if certifications %}
    <h2>Certifications</h2>
    {% for cert in certifications %}
      <div class="cert-item">{{ cert }}</div>
    {% endfor %}
  {% endif %}

  {% if languages %}
    <h2>Languages</h2>
    {% for lang in languages %}
      <div class="lang-item">{{ lang }}</div>
    {% endfor %}
  {% endif %}
</body>
</html>
